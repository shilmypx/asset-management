# Copy this file to .env.local and fill in your own Supabase project's values
# (Project Settings → API in the Supabase dashboard).
#
# Without these set, the app runs in demo mode against in-memory mock data —
# it still works, but nothing persists and writes are disabled.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
